# Secrets — never commit (spec §11.1)
.env
.env.*
!.env.example
!.env.production.example
/auth.json

# Dependencies
/vendor
/node_modules

# Build output. /public/build is committed ON PURPOSE: the server runs PHP
# only, with no Node.js, so the compiled CSS/JS must arrive with `git pull`.
# After any front-end change, run `npm run build` and commit public/build.
/public/hot
/public/fonts-manifest.dev.json
/public/storage

# Runtime
/storage/*.key
/storage/pail
*.log

# Generated at runtime, never source. Session files in particular carry live
# session payloads and must not reach a repository or a deploy upload.
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
.phpunit.result.cache
/.phpunit.cache

# A local SQLite database.
#
# The application runs on MySQL; a file here is somebody's development or
# review copy, seeded with the demo people. It is data, not source, and a
# committed one would put invented employees and their fixture identifiers into
# the repository.
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite3

# Uploads (stored outside the web root in production, spec §6)
#
# `/storage/app/private` is where Laravel's `local` disk points, and therefore
# where App\Support\Documents\DocumentStore writes everything — payslips,
# identity documents, profile photos. None of it is source, and the test suite
# writes real files there on every run.
/storage/app/uploads/
/storage/app/private/

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.zed/
.nova/
.phpactor.json
_ide_helper.php
*.swp

# Local Claude settings
.claude/settings.local.json

# Upload zips made by MAKE-UPLOAD.bat (deploy/build.php)
/upload
