APP_NAME="ZephryxLabs CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# MySQL / MariaDB, co-located with the application (foundation spec §10).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zephryx_crm
DB_USERNAME=root
DB_PASSWORD=

# ── Session ─────────────────────────────────────────────────────────────────
# Cookie flags and lifetimes per spec §4.4. SESSION_LIFETIME is NOT the policy —
# it is the outer bound beneath it, in minutes, set to the seven-day absolute
# ceiling (10080) so the framework never expires a session before
# App\Http\Middleware\EnforceSessionLifetime decides. The real windows live
# there: 30 days idle for staff and clients, 2 hours for the admin realm, and
# the seven-day ceiling over both. Shortening this silently overrules all three.
# `database`, and not `file`. §4.6 requires a password reset to invalidate every
# other session for that user, and no other driver can reach one — on `file` a
# reset appears to succeed while an attacker stays signed in with the password
# it just changed. §8 lists the `sessions` table for exactly this.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
# Host-only, and in production that is crm.zephryxlabs.in — NOT .zephryxlabs.in.
# The leading dot shares the session cookie with every subdomain, so anything
# ever hosted at www or blog could read it. `null` is host-only for local work.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# File cache avoids a database round trip per rate-limit check on shared hosting.
CACHE_STORE=file

# ── Mail ────────────────────────────────────────────────────────────────────
# MilesWeb SMTP in production (spec §10). OTP gates every sign-in, so SPF and
# DKIM must be configured before launch or nobody can sign in at all.
#
# TWO PROVIDERS, ONE DOMAIN. Staff mailboxes are Google Workspace on the apex.
# This sends as a SUBDOMAIN address so the apex SPF record Google owns is never
# edited — a domain may have exactly one SPF record, and a second TXT beside it
# invalidates both rather than merging. The subdomain carries its own SPF and
# DKIM selector, and DMARC's relaxed alignment still treats it as us.
#
# On Cloudflare, every MX and TXT record here must be DNS-only (grey cloud).
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@crm.zephryxlabs.in"
MAIL_FROM_NAME="${APP_NAME}"

# ── ZephryxLabs ─────────────────────────────────────────────────────────────
# Destination of the landing page's "Contact Support" call to action.
ZEPHRYX_SUPPORT_EMAIL=admin@zephryxlabs.in

# The owner (Admin Panel) account's password. Required in production —
# database/seeders/AccountSeeder refuses to seed the owner account without it
# rather than fall back to a default: a default password on the most
# powerful account in the application is the single worst thing a seeder can
# leave behind, because it survives every deploy and nobody notices it since
# the account works perfectly. Left blank in local + debug, where the seeder
# falls back to AccountSeeder::DEV_PASSWORD instead.
ZEPHRYX_OWNER_PASSWORD=

# Comma-separated proxy addresses whose X-Forwarded-For header may be trusted.
# Leave empty unless the app sits behind a proxy you control — login throttling
# and the audit log are keyed on the client IP (spec §4.2, §6).
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
