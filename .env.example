APP_NAME="ZephryxLabs CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# MySQL / MariaDB, co-located with the application (foundation spec §10).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zephryx_crm
DB_USERNAME=root
DB_PASSWORD=

# ── Session ─────────────────────────────────────────────────────────────────
# Cookie flags and lifetimes per spec §4.4. SESSION_LIFETIME is the *idle*
# timeout in minutes: 12 hours for staff and clients. The admin realm gets its
# own shorter window enforced in middleware when that realm is built.
# `database`, and not `file`. §4.6 requires a password reset to invalidate every
# other session for that user, and no other driver can reach one — on `file` a
# reset appears to succeed while an attacker stays signed in with the password
# it just changed. §8 lists the `sessions` table for exactly this.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# File cache avoids a database round trip per rate-limit check on shared hosting.
CACHE_STORE=file

# ── Mail ────────────────────────────────────────────────────────────────────
# PHPMailer over the MilesWeb SMTP account in production (spec §10). OTP gates
# every sign-in, so SPF and DKIM must be configured before launch.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@zephryxlabs.in"
MAIL_FROM_NAME="${APP_NAME}"

# ── ZephryxLabs ─────────────────────────────────────────────────────────────
# Destination of the landing page's "Contact Support" call to action.
ZEPHRYX_SUPPORT_EMAIL=admin@zephryxlabs.in

# Comma-separated proxy addresses whose X-Forwarded-For header may be trusted.
# Leave empty unless the app sits behind a proxy you control — login throttling
# and the audit log are keyed on the client IP (spec §4.2, §6).
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
