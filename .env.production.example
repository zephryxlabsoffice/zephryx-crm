# Production environment for crm.zephryxlabs.in (foundation spec §10 —
# shared hosting, co-located MySQL, MilesWeb SMTP).
#
# ═════════════════════════════════════════════════════════════════════════════
# THIS IS A TEMPLATE, NOT A FILE TO DEPLOY AS-IS
#
# Copy this to `.env` on the server and fill in every value marked
# CHANGE THIS. Nothing here is a working secret — that is the point of a
# committed template. `.env.example` (the local-development version, checked
# in beside this one) documents what each setting means and why; read that
# first if a value here is not self-explanatory.
#
# Do not copy your local `.env` to the server instead of using this file. The
# local one points at a throwaway database with no password and runs with
# `APP_DEBUG=true`, which leaks stack traces (including config values) to
# anyone who can trigger an error on a live site.
# ═════════════════════════════════════════════════════════════════════════════

APP_NAME="ZephryxLabs CRM"
APP_ENV=production
# Generate fresh ON THE SERVER with `php artisan key:generate` — never reuse a
# development key. Whoever holds this key can decrypt every `encrypted` column
# in the database (identity documents, bank details, the Google service
# account key) and forge signed URLs and session cookies.
APP_KEY=
# CHANGE THIS if it is ever false: a production app with debug on renders a
# full stack trace, including environment values, on any unhandled error.
APP_DEBUG=false
APP_URL=https://crm.zephryxlabs.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` is a development default. Production logs at `error` so the daily
# log files stay a record of things that actually went wrong, not every
# notice and deprecation.
LOG_LEVEL=error

# ── Database ────────────────────────────────────────────────────────────────
# MySQL / MariaDB, co-located with the application (foundation spec §10).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zephryx_crm
# CHANGE THIS — a dedicated database user, never `root`, and never blank.
DB_USERNAME=
DB_PASSWORD=

# ── Session ─────────────────────────────────────────────────────────────────
# Cookie flags and lifetimes per spec §4.4. SESSION_LIFETIME is NOT the
# policy — it is the outer bound beneath it, in minutes, set to the
# seven-day absolute ceiling (10080) so the framework never expires a
# session before App\Http\Middleware\EnforceSessionLifetime decides. The
# real windows live there: 30 days idle for staff and clients, 2 hours for
# the admin realm, and the seven-day ceiling over both.
#
# `database`, and not `file`: §4.6 requires a password reset to invalidate
# every other session for that user, and no other driver can reach one — on
# `file` a reset appears to succeed while an attacker stays signed in with
# the password it just changed.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
# Host-only. NOT `.zephryxlabs.in` — the leading dot shares the session
# cookie with every subdomain, so anything ever hosted at www or blog could
# read it.
SESSION_DOMAIN=crm.zephryxlabs.in
# Requires HTTPS, which production has and local development does not.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# File cache avoids a database round trip per rate-limit check on shared
# hosting — this one is already the production-appropriate value.
CACHE_STORE=file

# ── Mail ────────────────────────────────────────────────────────────────────
# MilesWeb SMTP in production. OTP gates every sign-in, so SPF and DKIM must
# be configured on the sending domain before launch, or nobody can sign in.
#
# TWO PROVIDERS, ONE DOMAIN. Staff mailboxes are Google Workspace on the
# apex. This sends as a SUBDOMAIN address so the apex SPF record Google owns
# is never edited — a domain may have exactly one SPF record, and a second
# TXT beside it invalidates both rather than merging. The subdomain carries
# its own SPF and DKIM selector, and DMARC's relaxed alignment still treats
# it as us.
#
# On Cloudflare, every MX and TXT record for this must be DNS-only (grey
# cloud) — proxying a mail record breaks it.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
# CHANGE THIS — the MilesWeb SMTP host for crm.zephryxlabs.in.
MAIL_HOST=
MAIL_PORT=587
# CHANGE THIS
MAIL_USERNAME=
# CHANGE THIS
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@crm.zephryxlabs.in"
MAIL_FROM_NAME="${APP_NAME}"

# ── ZephryxLabs ─────────────────────────────────────────────────────────────
# Destination of the landing page's "Contact Support" call to action.
ZEPHRYX_SUPPORT_EMAIL=admin@zephryxlabs.in

# CHANGE THIS — required in production. database/seeders/AccountSeeder
# refuses to seed the owner (Admin Panel) account without it rather than
# fall back to a default password on the most powerful account in the
# application. Pick something you will change immediately after first
# sign-in, since this value sits in a config file.
ZEPHRYX_OWNER_PASSWORD=

# Comma-separated proxy addresses whose X-Forwarded-For header may be
# trusted. Leave empty unless the app sits behind a proxy you control — login
# throttling and the audit log are keyed on the client IP (spec §4.2, §6).
# Shared hosting typically has no such proxy in front of it; check with
# MilesWeb before setting this.
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
